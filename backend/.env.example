NODE_ENV=development
PORT=3000
LOG_LEVEL=debug

DATABASE_URL=postgres://intellicart:dev@localhost:5432/intellicart
REDIS_URL=redis://localhost:6379

# Split origin: the SPA is served from GitHub Pages, this API from elsewhere.
# Explicit allowlist, comma separated, no wildcards.
CORS_ORIGINS=http://localhost:5173,http://localhost:4173
COOKIE_DOMAIN=
COOKIE_SECRET=dev-only-cookie-secret-change-me
SESSION_TTL_DAYS=30

# Local: the `storage` (RustFS) service in docker-compose.yml; `storage-init`
# creates the bucket. Must be browser-reachable — presigned URLs embed this host.
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=intellicart-media
S3_ACCESS_KEY=minio
S3_SECRET_KEY=minio123

SMTP_URL=smtp://localhost:1025
# Optional sender for order emails (default: IntelliCart <no-reply@intellicart.local>).
# Emails are sent by the worker (npm run dev:worker); see them at http://localhost:8025.
# MAIL_FROM="IntelliCart <orders@example.com>"

# Blank => /ai/assistant falls back to deterministic answers instead of
# calling the model. That is the default for local and preview.
ANTHROPIC_API_KEY=
AI_MODEL=claude-sonnet-5
AI_MONTHLY_BUDGET_USD=25

# Lets an owner wipe and reseed the database from Settings → Demo data.
# Defaults to false when NODE_ENV=production.
ALLOW_DEMO_SEED=true
