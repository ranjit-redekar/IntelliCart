{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "outDir": "dist",
    "rootDir": "src",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "declaration": false,
    "sourceMap": true
  },
  "include": ["src"],
  // seed.ts and selfcheck.ts are ops scripts run through tsx. seedData.ts is
  // NOT excluded: the admin UI can trigger a reseed, so it has to compile.
  "exclude": ["src/db/seed.ts", "src/selfcheck.ts", "dist"]
}
